# DataGSM OAuth Client 관리 페이지에서 발급받은 Client ID
DATAGSM_CLIENT_ID=your-datagsm-client-id

# DataGSM에 등록한 callback URI와 동일해야 합니다.
DATAGSM_REDIRECT_URI=http://localhost:5173/auth/callback

# Frontend URL to open after OAuth login/logout.
DATAGSM_FRONTEND_BASE_URL=http://localhost:5173

# Optional: machine-specific JDK 21 path. Leave empty to use JAVA_HOME or PATH.
DATAGSM_JAVA_HOME=
